# TMDB (The Movie Database) API key for show metadata, posters, and episode info.
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# TVDB (TheTVDB) API key for supplemental episode metadata.
# Get one at https://thetvdb.com/dashboard/account/apikey
TVDB_API_KEY=

# Port the addon HTTP server listens on (default: 7000)
PORT=7000
